# Calls to the make program, recorded with a logging ninja wrapper (cwd, then argv).
# $BUILD is the build dir; $REPO the kiln checkout CMake/Meson ran from.
## configure
$REPO	--version
$BUILD/CMakeFiles/CMakeTmp	--version
$BUILD/CMakeFiles/CMakeTmp	-C $BUILD/CMakeFiles/CMakeTmp -t recompact
$BUILD/CMakeFiles/CMakeTmp	-C $BUILD/CMakeFiles/CMakeTmp -t restat build.ninja
$BUILD/CMakeFiles/CMakeTmp	cmTC_xxxxx
$BUILD/CMakeFiles/CMakeTmp	--version
$BUILD/CMakeFiles/CMakeTmp	-C $BUILD/CMakeFiles/CMakeTmp -t recompact
$BUILD/CMakeFiles/CMakeTmp	-C $BUILD/CMakeFiles/CMakeTmp -t restat build.ninja
$BUILD/CMakeFiles/CMakeTmp	cmTC_xxxxx
$REPO	-C $BUILD -t restat build.ninja
## build
$BUILD	
## build -j3 target app
$BUILD	-j 3 app
## regenerate (touch CMakeLists)
$BUILD	
$BUILD	--version
$BUILD	-C $BUILD -t restat build.ninja
## clean
$BUILD	clean
$BUILD	-t clean
## install target
$BUILD	install
## cmake --install
## ctest
## test target
$BUILD	test
